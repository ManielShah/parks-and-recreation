{
  "name": "parks-and-recreation",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "db:migrate": "npm run migrate --workspace server",
    "db:seed": "npm run seed --workspace server",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "test": "npm test --workspace server",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
