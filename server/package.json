{
  "name": "@parks/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:pg-native --external:express --external:pg --external:zod --outfile=dist/index.js && cp -r migrations dist/",
    "migrate": "tsx --env-file-if-exists=../.env src/cli/migrate.ts",
    "seed": "tsx --env-file-if-exists=../.env src/cli/seed.ts",
    "typecheck": "tsc -p .",
    "test": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://parks:parks@localhost:5432/parks_test} tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@parks/shared": "*",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.24.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
